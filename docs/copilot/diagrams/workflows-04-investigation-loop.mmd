VALID{"Arguments valid?<br/>exact key set ·<br/>strict decimal · enum"}
REJECT["One failed observation<br/>with a reason<br/><b>the batch continues</b>"]
SEED{"Already in the<br/>seeded snapshot?"}
FROMSEED["Served from seed<br/>tagged source · inherits<br/>the seed's timestamp"]
CALL["MCP call<br/><b>own 15s deadline</b>"]
OBS["Observation recorded<br/>id · timestamp · status<br/>sanitised · 16KB cap"]

CLARIFY(["CLARIFY"])
BLOCKED(["BLOCKED"])
DONE(["RESEARCH COMPLETE"])
STOP(["DEADLINE<br/>keep what was gathered"])

START --> TURN
TURN -->|no| STOP
