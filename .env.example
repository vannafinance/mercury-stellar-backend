# Copy to .env.local and fill in secrets. Never commit .env.local.

# ---- Copilot (in-process — runs inside Next.js, no uvicorn) ----
LLM_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=vanna-mcp
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=gemini-3.7-flash
# If primary model 404s, try these (comma-separated)
# VERTEX_MODEL_FALLBACKS=gemini-2.5-flash,gemini-2.0-flash-001
#
# ---- Vertex auth ----
# NO END USER EVER TOUCHES GOOGLE AUTH. Vertex is called server-side on behalf of the
# project, so the credential is the app's, not the visitor's. The only question is which
# credential the SERVER presents. Two permanent answers, in preference order:
#
# 1) WORKLOAD IDENTITY FEDERATION — keyless, nothing to rotate. Best for production.
#    The host mints a short OIDC token proving which deployment is running; Google's STS
#    trades it for an access token. No private key exists to leak or rotate.
#    One-time GCP setup, then set the audience below and Vercel supplies the token itself.
#
#      PROJECT_NUM=$(gcloud projects describe vanna-mcp --format='value(projectNumber)')
#      gcloud iam workload-identity-pools create vercel \
#        --project vanna-mcp --location global --display-name "Vercel"
#      gcloud iam workload-identity-pools providers create-oidc vercel-oidc \
#        --project vanna-mcp --location global --workload-identity-pool vercel \
#        --issuer-uri "https://oidc.vercel.com/<your-vercel-team-slug>" \
#        --allowed-audiences "https://vercel.com/<your-vercel-team-slug>" \
#        --attribute-mapping "google.subject=assertion.sub"
#      # let the federated identity act as the service account
#      gcloud iam service-accounts add-iam-policy-binding \
#        vanna-copilot@vanna-mcp.iam.gserviceaccount.com --project vanna-mcp \
#        --role roles/iam.workloadIdentityUser \
#        --member "principalSet://iam.googleapis.com/projects/$PROJECT_NUM/locations/global/workloadIdentityPools/vercel/*"
#
#    Then, on Vercel only (enable OIDC in Project Settings → Security):
# GOOGLE_WORKLOAD_IDENTITY_AUDIENCE=//iam.googleapis.com/projects/<PROJECT_NUM>/locations/global/workloadIdentityPools/vercel/providers/vercel-oidc
# GOOGLE_WORKLOAD_IDENTITY_SERVICE_ACCOUNT=vanna-copilot@vanna-mcp.iam.gserviceaccount.com
#    Optional: GOOGLE_OIDC_TOKEN_ENV to read the OIDC token from a different variable
#    (defaults to VERCEL_OIDC_TOKEN), so this also works on Cloud Run / GitHub Actions.
#
#    NOTE: on Cloud Run you need none of this — the attached service account is picked up
#    automatically by ADC further down the chain. Federation is for hosts outside GCP.
#
# 2) SERVICE-ACCOUNT KEY — one secret, set once, works locally too. Use this for local
#    development, and for production if you would rather not set up a pool.
#
# ---- Option 2: SET THIS ONE, and nobody needs `gcloud auth login` ----
# A service-account key for a service account with roles/aiplatform.user on
# GOOGLE_CLOUD_PROJECT. Paste the whole key file, or its base64 (base64 is easier in
# hosting dashboards, which mangle multi-line values). Accepted either way.
#
#   gcloud iam service-accounts create vanna-copilot --project vanna-mcp
#   gcloud projects add-iam-policy-binding vanna-mcp \
#     --member=serviceAccount:vanna-copilot@vanna-mcp.iam.gserviceaccount.com \
#     --role=roles/aiplatform.user
#   gcloud iam service-accounts keys create key.json \
#     --iam-account=vanna-copilot@vanna-mcp.iam.gserviceaccount.com
#   # then: base64 -w0 key.json   (macOS: base64 -i key.json)
#
# This is the ONLY auth option that is machine-independent. Without it the copilot falls
# back to this machine's `gcloud auth login`, which expires — and when it does, routing
# silently degrades to keyword matching, so the same prompt answers on one laptop and
# returns the generic capability list on another. It also cannot work on a serverless
# host at all: there is no gcloud binary and no ADC file on Vercel.
# The copilot header shows a "gcloud login" warning chip whenever this is unset.
GOOGLE_SERVICE_ACCOUNT_JSON=
#
# Local fallback only, if you have not set the key above: `gcloud auth login` with an
# account that has Vertex access. You do NOT need `gcloud auth application-default
# login` — plain user login is enough, and ADC fails with invalid_rapt on some accounts.

MCP_MODE=live
MCP_BASE_URL=https://mcp.vanna.finance/mcp

# WorkOS machine-to-machine (server-to-server) auth for MCP.
# Used for READS only. Its token's `sub` is the client id — one value for every
# user — so it cannot prove who is asking and cannot authorize auto-sign.
WORKOS_M2M_CLIENT_ID=
WORKOS_M2M_CLIENT_SECRET=
# Use your AuthKit /oauth2/token URL, NOT api.workos.com/sso/token
WORKOS_M2M_TOKEN_URL=https://your-project.authkit.app/oauth2/token

# ---- End-user login: Connect OAuth + resource indicator ----
#
# Needed for AUTO-SIGN. Without it the app still works: reads run on M2M and
# writes fall back to signing in the user's wallet. With it, writes go to the MCP
# under the user's own token, which is the only thing the Sign Service accepts as
# proof of identity on a money path.
#
# Dashboard prerequisites (WorkOS):
#   1. A Connect OAuth client for THIS app (not the M2M client).
#   2. Its redirect URI registered as <your origin>/api/auth/callback.
#   3. The MCP resource indicator registered — https://mcp.vanna.finance/mcp.
#
# An OAuth flow is needed because a plain AuthKit session token has the right
# `sub` but NO `aud` claim, so neither the MCP nor the Sign Service accepts it.
# Which `aud` you get back depends on the client type — see MCP_SEND_RESOURCE.
#
# The Connect OAuth client id — NOT WORKOS_M2M_CLIENT_ID. Using the M2M id here
# yields a `client_…` subject, which the Sign Service refuses by design.
WORKOS_CLIENT_ID=
WORKOS_CLIENT_SECRET=
# Optional: derived from WORKOS_M2M_TOKEN_URL when unset.
# WORKOS_ISSUER=https://your-project.authkit.app
# Send the RFC 8707 `resource` indicator? DEFAULT false — leave it unset.
#
# A hand-created Connect OAuth app (made in the WorkOS Dashboard, "Managed by
# you", confidential) answers an explicit `resource` on the token endpoint with
#   400 invalid_target
# EVEN WHEN that exact URI is registered as the Default Resource Indicator. Per
# WorkOS, the default applies only to DCR/CIMD clients; hand-created OAuth and
# M2M Connect apps never use it. Observed live: authorize returned a code, the
# exchange 400'd, login never completed.
#
# So this client type mints:
#     aud = <WORKOS_ENV_CLIENT_ID>   the WorkOS ENVIRONMENT client id — measured
#                                    live; NOT the MCP URI and NOT the Connect
#                                    app's own client id
#     sub = user_…                   a real per-user subject
#
# That is still a correct end-user token: `sub` is what closes the impersonation
# hole, what bindings key on, and what the Sign Service's ^user_ guard checks.
#
# Set true ONLY if the Copilot is re-registered as a DCR/CIMD client, which does
# mint aud = the MCP resource URI.
# MCP_SEND_RESOURCE=false

# The WorkOS ENVIRONMENT client id — Developer → API Keys. Staging is
# client_01KX5H81JH2HWD2DHKYFYFXNS2.
#
# This is what actually lands in `aud` on a hand-created Connect OAuth token.
# Without it, /api/auth/session reports audienceMatchesMcp:false on a perfectly
# good login.
WORKOS_ENV_CLIENT_ID=

# ---- Sign Service must accept whichever audience arrives ----
# On the deployed Sign Service:
#   WORKOS_AUDIENCE=https://mcp.vanna.finance/mcp,<WORKOS_ENV_CLIENT_ID>
# The MCP URI for real MCP/DCR clients; the environment client id for this
# hand-created one. Add <WORKOS_CLIENT_ID> too only if a token is ever observed
# carrying it.
#
# !! READ THIS BEFORE CHANGING THE AUDIENCE LIST !!
#
# The environment client id is ALSO the audience on the M2M token
# (AUTOSIGN_AUDIENCE_BLOCKER.md §1 — same value, client_01KX5H81…). Once it is
# accepted, `aud` NO LONGER separates an end user from the machine credential.
# The only thing that does is `sub`:
#
#     end user  → sub = user_…      accepted
#     M2M       → sub = client_…    refused by the ^user_ guard
#
# So the subject guard in sign-service/src/api/auth-user.ts is not defence in
# depth here — it is the entire separation. Removing or loosening it turns this
# configuration into the §4a impersonation hole immediately and silently.
# Regression test: "M2M token on an ACCEPTED audience is still refused" in
# sign-service/src/api/auth-user.test.ts uses exactly this audience.
#
# Still NEVER add the M2M token's SUBJECT (client_01KXBNHS…) anywhere, and do
# not treat these client ids as interchangeable with it.
#
# Optional: only used when MCP_SEND_RESOURCE is true. Defaults to MCP_BASE_URL so
# the audience and the server called cannot drift apart.
# MCP_RESOURCE=https://mcp.vanna.finance/mcp
# Optional: derived from the request origin when unset. Set it explicitly behind
# a proxy that rewrites Host, and make it match the dashboard registration.
# COPILOT_AUTH_REDIRECT_URI=https://app.vanna.finance/api/auth/callback
# Required for login. Encrypts the session cookie (it holds a live access token
# and a refresh token). At least 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
COPILOT_SESSION_SECRET=

MIN_HEALTH_FACTOR=1.30
MAX_LEVERAGE=10
MAX_POSITION_USD=50000
COPILOT_READS_ONLY=false
# Max atomic legs per multi-step strategy (default 8, max 12)
# COPILOT_MULTI_LEG_MAX=8
# Per-turn structured logs (also on by default in NODE_ENV=production)
# COPILOT_LOG=1

# ---- App (existing) ----
# REQUIRED for the Vanna embedded wallet. Without it Privy is disabled app-wide:
# the "Vanna wallet" login option is hidden and only Freighter can connect.
# Value is the app ID from the Privy dashboard (public — it ships to the browser).
NEXT_PUBLIC_PRIVY_APP_ID=

# ---- Signing-authority bind (auto-sign) ----
# Turning auto-sign on has to bind the wallet to the user at the Sign Service, or
# every enable returns `wallet_not_bound` (403) forever. That binding needs one
# consent — Vanna's signer quorum added as an ADDITIONAL signer on the user's own
# wallet — and the copilot completes it in-app via Privy's SDK, so the user never
# leaves the page. Both vars below are OPTIONAL: without them the in-app path still
# works, because the signer id is read from the Connect Gateway's own /connect page
# and the gateway origin from the connect_url the Sign Service returns.
#
# Set this ONLY if the Connect Gateway has a non-empty CONNECT_ORIGIN_ALLOWLIST.
# The register call is server-to-server and so carries no browser Origin; the
# gateway 403s `origin_not_allowed` on an absent Origin once its allowlist is set.
# Set this to this app's public origin AND add that same origin to the gateway's
# CONNECT_ORIGIN_ALLOWLIST. (Leaving the gateway's allowlist empty also works.)
# COPILOT_PUBLIC_ORIGIN=https://app.vanna.finance
#
# Pin the Connect Gateway instead of deriving it per request. Needed only if the
# register call can land on a different server instance than the one that minted the
# connect request (the derived origin is per-instance and short-lived).
# SIGN_CONNECT_BASE_URL=https://vanna-connect-gateway-xxxxx-uc.a.run.app
#
# Skip reading the signer id from the gateway page. Non-secret — the gateway ships
# it to every browser that loads /connect.
# PRIVY_SIGNER_ID=

# SOROBAN_RPC_URL=
# HORIZON_URL=
