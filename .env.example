# Copy to .env.local and fill in secrets. Never commit .env.local.

# ---- Copilot (in-process — runs inside Next.js, no uvicorn) ----
LLM_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=vanna-mcp
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=gemini-3.6-flash
# If primary model 404s, try these (comma-separated)
# VERTEX_MODEL_FALLBACKS=gemini-2.5-flash,gemini-2.0-flash-001
#
# ---- Vertex auth: SET THIS ONE, and nobody needs `gcloud auth login` ----
# A service-account key for a service account with roles/aiplatform.user on
# GOOGLE_CLOUD_PROJECT. Paste the whole key file, or its base64 (base64 is easier in
# hosting dashboards, which mangle multi-line values). Accepted either way.
#
#   gcloud iam service-accounts create vanna-copilot --project vanna-mcp
#   gcloud projects add-iam-policy-binding vanna-mcp \
#     --member=serviceAccount:vanna-copilot@vanna-mcp.iam.gserviceaccount.com \
#     --role=roles/aiplatform.user
#   gcloud iam service-accounts keys create key.json \
#     --iam-account=vanna-copilot@vanna-mcp.iam.gserviceaccount.com
#   # then: base64 -w0 key.json   (macOS: base64 -i key.json)
#
# This is the ONLY auth option that is machine-independent. Without it the copilot falls
# back to this machine's `gcloud auth login`, which expires — and when it does, routing
# silently degrades to keyword matching, so the same prompt answers on one laptop and
# returns the generic capability list on another. It also cannot work on a serverless
# host at all: there is no gcloud binary and no ADC file on Vercel.
# The copilot header shows a "gcloud login" warning chip whenever this is unset.
GOOGLE_SERVICE_ACCOUNT_JSON=
#
# Local fallback only, if you have not set the key above: `gcloud auth login` with an
# account that has Vertex access. You do NOT need `gcloud auth application-default
# login` — plain user login is enough, and ADC fails with invalid_rapt on some accounts.

MCP_MODE=live
MCP_BASE_URL=https://mcp.vanna.finance/mcp

# WorkOS machine-to-machine (server-to-server) auth for MCP
WORKOS_M2M_CLIENT_ID=
WORKOS_M2M_CLIENT_SECRET=
# Use your AuthKit /oauth2/token URL, NOT api.workos.com/sso/token
WORKOS_M2M_TOKEN_URL=https://your-project.authkit.app/oauth2/token

MIN_HEALTH_FACTOR=1.30
MAX_LEVERAGE=10
MAX_POSITION_USD=50000
COPILOT_READS_ONLY=false
# Max atomic legs per multi-step strategy (default 8, max 12)
# COPILOT_MULTI_LEG_MAX=8
# Per-turn structured logs (also on by default in NODE_ENV=production)
# COPILOT_LOG=1

# ---- App (existing) ----
# REQUIRED for the Vanna embedded wallet. Without it Privy is disabled app-wide:
# the "Vanna wallet" login option is hidden and only Freighter can connect.
# Value is the app ID from the Privy dashboard (public — it ships to the browser).
NEXT_PUBLIC_PRIVY_APP_ID=
# SOROBAN_RPC_URL=
# HORIZON_URL=
